{
  "name": "claude-cli-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local multi-agent orchestrator and append-only communications ledger for Claude Code CLI agents.",
  "engines": { "node": ">=22" },
  "bin": { "orchestrator": "./dist/cli/main.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "orchestrator": "tsx src/cli/main.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
